{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": "npm run build && rm -rf dist && cp -r public dist && rm -f dist/index.php dist/.htaccess",
    "outputDirectory": "dist",
    "regions": [
        "fra1"
    ],
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.3",
            "maxDuration": 60,
            "excludeFiles": "{node_modules/**,tests/**,docker/**,storage/logs/**,resources/css/**,resources/js/**}"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api/index.php"
        }
    ],
    "crons": [
        {
            "path": "/cron/daily",
            "schedule": "0 6 * * *"
        }
    ]
}
